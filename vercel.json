{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/booking", "destination": "/booking/" },
    { "source": "/therapy", "destination": "/therapy/" },
    { "source": "/training", "destination": "/training/" },
    { "source": "/research", "destination": "/research/" },
    { "source": "/organisations", "destination": "/organisations/" },
    { "source": "/about", "destination": "/about/" },
    { "source": "/contact", "destination": "/contact/" },
    { "source": "/blog", "destination": "/blog/" },
    { "source": "/careers", "destination": "/careers/" },
    { "source": "/policies", "destination": "/policies/" }
  ]
}